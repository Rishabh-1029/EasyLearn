# Use the same OAuth 2.0 Web client ID configured in Frontend/my-app/.env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Replace with at least 32 random characters; use a secret manager in deployment.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep true for HTTPS deployments. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Comma-separated exact frontend origins. Set this to the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
